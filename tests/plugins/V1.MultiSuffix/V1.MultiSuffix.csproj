<Project Sdk="Microsoft.NET.Sdk">

  <!-- 测试插件（V1 / format，同一格式两个后缀别名）。引用当前 V1 SDK，Private=false 不打进包。
       输出落 tests/packages/v1-multisuffix/。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\packages\v1-multisuffix\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TuneLab.Foundation\TuneLab.Foundation.csproj" Private="false" />
    <ProjectReference Include="..\..\..\TuneLab.SDK\TuneLab.SDK.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 两个条目共享的唯一一份 introduction（测详情窗按文件路径去重 → 只显一页）。 -->
    <Content Include="Introduction.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
