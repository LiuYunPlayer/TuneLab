{
  "id": "com.tunelab.test.routeconflict.b",
  "name": "Route Conflict B",
  "version": "1.0.0",
  "author": "TuneLab Tests",
  "description": "冲突消解夹具 B：与包 A 同声明扩展名 .tlroute（import+export）。导入产出轨名标注「Package B」，导出写 exportedBy=B。导入与导出是两个类，故写成两个条目。",
  "sdk-version": "1.0",
  "extensions": [
    { "type": "format", "import-suffixes": ["tlroute"], "name": "Route Conflict B (Import)", "class": "TuneLab.TestPlugins.RouteConflictB.RouteImport", "assembly": "V1.RouteConflict.B.dll" },
    { "type": "format", "export-suffixes": ["tlroute"], "name": "Route Conflict B (Export)", "class": "TuneLab.TestPlugins.RouteConflictB.RouteExport", "assembly": "V1.RouteConflict.B.dll" }
  ]
}
