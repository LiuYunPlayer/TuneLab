<Project Sdk="Microsoft.NET.Sdk">

  <!-- 测试插件（V1 / voice，仅 Windows）：自定义设置窗口的推荐形态——插件本体【不引任何 UI 框架】，设置页的按钮只负责
       启动作者自己的界面 exe（见 ../V1.CustomWindow.Editor，输出到本包的 editor/ 子目录）。引用当前 V1 SDK，Private=false
       不打进包。输出落 tests/packages/v1-customwindow/。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\packages\v1-customwindow\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TuneLab.Foundation\TuneLab.Foundation.csproj" Private="false" />
    <ProjectReference Include="..\..\..\TuneLab.SDK\TuneLab.SDK.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
