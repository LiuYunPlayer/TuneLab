<Project Sdk="Microsoft.NET.Sdk">

  <!-- tunelab 命令行：从终端（或 CI）驱动运行中的 TuneLab，跑的是与 AI Agent 面板同一份命令。
       引用 TuneLab 是为了【离线也能列出命令树】——CommandRegistry 是纯声明，不启动宿主也自省得出，
       故 help 与参数校验都不需要连上宿主（见 docs/command-surface.md §9.2）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 程序集名【不能】叫 tunelab：它会与被引用的 TuneLab.dll 在同一输出目录里同名（Windows 文件名
         不区分大小写），互相覆盖。设计文档里的命令名 `tunelab` 是【安装期】的事——装包时给
         TuneLab.Cli.exe 落一个 tunelab 的入口（.cmd / 符号链接）即可，与程序集名无关。 -->
    <AssemblyName>TuneLab.Cli</AssemblyName>
    <RootNamespace>TuneLab.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TuneLab.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TuneLab\TuneLab.csproj" />
  </ItemGroup>

  <!-- Legacy 兼容层：主程序把它拷进【自己的】输出目录（见 TuneLab.csproj 的 CopyLegacyCompat），
       那是散拷不是 Content，故不会随 ProjectReference 流到这里。不补这一步，headless 模式下
       legacy 插件会被整体跳过——同一台机器、同一个数据目录，命令行看到的扩展面却与应用不同，
       而那种差异排查起来极难。主程序的 BuildLegacyCompat 已经保证产物就绪，这里只负责搬。 -->
  <Target Name="CopyLegacyCompatToCli" AfterTargets="Build">
    <ItemGroup>
      <CliLegacyCompatBinary Include="$(MSBuildThisFileDirectory)..\legacy\compat\TuneLab.Hosting.Compat.Legacy\bin\$(Configuration)\net8.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CliLegacyCompatBinary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
